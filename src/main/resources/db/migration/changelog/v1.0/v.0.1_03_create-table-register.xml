<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="3" author="Kolivim">

        <preConditions onFail="MARK_RAN">
            <tableExists schemaName="doc_workflow" tableName="documents"/>
            <not>
                <tableExists tableName="register"/>
            </not>
        </preConditions>

        <createTable tableName="register" schemaName="doc_workflow">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true"
                             nullable="false"
                             foreignKeyName="fk_register_documents"
                             references="doc_workflow.documents(id)"/>
            </column>
        </createTable>

<!--        <addForeignKeyConstraint-->
<!--                baseColumnNames="id"-->
<!--                baseTableName="register"-->
<!--                baseTableSchemaName="doc_workflow"-->
<!--                constraintName="fk_register_id"-->
<!--                referencedColumnNames="id"-->
<!--                referencedTableName="documents"-->
<!--                referencedTableSchemaName="doc_workflow"/>-->

    </changeSet>

</databaseChangeLog>

